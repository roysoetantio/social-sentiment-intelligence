# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RapidAPI (Twitter135 + Real-Time News)
VITE_RAPIDAPI_KEY=your-rapidapi-key
VITE_TWITTER135_API_KEY=your-twitter135-key   # optional, falls back to VITE_RAPIDAPI_KEY

# Google Custom Search
VITE_GOOGLE_CSE_KEY=your-google-cse-key
VITE_GOOGLE_CSE_CX=your-google-cse-cx

# Serper
SERPER_API_KEY=your-serper-key

# World News API
WORLDNEWS_API_KEY=your-worldnews-key
